rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedEmail() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedEmail() && request.auth.uid == userId;
    }

    function isSuperAdmin() {
      return isVerifiedEmail() && request.auth.token.email == 'fftra900@gmail.com';
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.uid == request.auth.uid
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254 && data.email == request.auth.token.email
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAuthorizedAdmin(data) {
      return data.keys().hasAll(['email', 'role', 'addedByUid', 'addedByEmail', 'createdAt'])
        && data.keys().hasOnly(['email', 'role', 'addedByUid', 'addedByEmail', 'createdAt'])
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.role is string && data.role in ['super_admin', 'admin']
        && data.addedByUid is string && data.addedByUid.size() >= 1 && data.addedByUid.size() <= 128 && data.addedByUid == request.auth.uid
        && data.addedByEmail is string && data.addedByEmail.size() >= 3 && data.addedByEmail.size() <= 254 && data.addedByEmail == request.auth.token.email
        && data.createdAt is timestamp;
    }

    function isValidLoginAudit(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'status', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'status', 'createdAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid == request.auth.uid
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254 && data.email == request.auth.token.email
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.status is string && data.status in ['granted', 'denied']
        && data.createdAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isSuperAdmin());
      allow list: if isVerifiedEmail() && (existing().uid == request.auth.uid || isSuperAdmin());
      allow create: if isVerifiedEmail()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedEmail()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt']);
      allow delete: if false;
    }

    match /authorizedAdmins/{adminId} {
      allow get: if isVerifiedEmail()
        && isValidId(adminId)
        && (isSuperAdmin() || (resource != null && existing().email == request.auth.token.email));
      allow list: if isSuperAdmin();
      allow create: if isSuperAdmin()
        && isValidId(adminId)
        && isValidAuthorizedAdmin(incoming())
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isSuperAdmin()
        && isValidId(adminId)
        && existing().email != 'fftra900@gmail.com';
    }

    match /loginAudits/{auditId} {
      allow get: if isValidId(auditId) && isSuperAdmin();
      allow list: if isSuperAdmin();
      allow create: if isVerifiedEmail()
        && isValidId(auditId)
        && isValidLoginAudit(incoming())
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if false;
    }
  }
}
